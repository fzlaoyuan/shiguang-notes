{
  "name": "shiguang-notes",
  "productName": "拾光便签",
  "version": "1.0.0",
  "description": "离线图文便签与桌面速记",
  "main": "src/main.cjs",
  "author": "Local Notes",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "pack": "node scripts/package.cjs"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "lucide": "^0.468.0"
  },
  "build": {
    "appId": "local.shiguang.notes",
    "productName": "拾光便签",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/store.cjs",
      "dist/**/*",
      "package.json",
      "assets/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
